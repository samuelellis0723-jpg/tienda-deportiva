# Copia a .env y completa valores locales. Nunca subas .env a Git.
PORT=3000
NODE_ENV=development
DB_HOST=localhost
DB_PORT=5432
DB_NAME=oje_dev
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false
FRONTEND_ORIGIN=http://localhost:5173
# En producción usa SameSite=none solo si frontend y API son cross-site; requiere HTTPS.
SESSION_COOKIE_SAME_SITE=lax
